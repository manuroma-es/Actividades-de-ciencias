{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "actividades-admin",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true }
}
