{
  "name": "actividades-de-ciencias",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=20.9.0" },
  "scripts": {
    "dev": "vite out",
    "build": "next build",
    "start": "serve out",
    "catalog:migrate": "python3 scripts/migrate-science-data.py",
    "catalog:migrate:check": "python3 scripts/migrate-science-data.py --check",
    "catalog:generate": "python3 scripts/generate-catalog.py",
    "catalog:validate": "python3 scripts/validate-catalog.py",
    "catalog:check": "npm run catalog:migrate:check && npm run catalog:generate && npm run catalog:validate",
    "test": "npm run build && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern out"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "serve": "14.2.5",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
